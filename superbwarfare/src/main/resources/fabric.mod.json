{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://github.com/Mercurows/SuperbWarfare"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "accessWidener": "superbwarfare.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.atsuishio.superbwarfare.Mod"
    ],
    "client": [
      "com.atsuishio.superbwarfare.client.SuperbWarfareFabricClient"
    ],
    "cardinal-components": [
      "com.atsuishio.superbwarfare.init.ModComponents"
    ]
  },
  "custom": {
    "cardinal-components": [
      "superbwarfare:player_variable",
      "superbwarfare:phosphorus_fire_capability",
      "superbwarfare:infinite_ammo_capability"
    ]
  },
  "mixins": [
    "superbwarfare.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "cloth-config": "*",
    "forgeconfigapiport": "*",
    "trinkets": "*",
    "simplebedrockmodel": "*",
    "geckolib4": "*",
    "sbw_portlib": "*"
  },
  "suggests": {
    "jei": "*",
    "jade": "*",
    "iris": "*",
    "sodium": "*"
  }
}